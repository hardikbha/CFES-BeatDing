#!/bin/bash
#PBS -N ff2ExpProfile
#PBS -q workq
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /home/sachin.chaudhary/ces_fl_runs/ff2_expanded_e7648fb/profile_allocation.log
set -Eeuo pipefail
umask 077
ROOT=/home/sachin.chaudhary/ces_fl_runs/ff2_expanded_e7648fb
SOURCE=/home/sachin.chaudhary/ces_fl_sources/ff2-expanded-e7648fb
PY=/home/sachin.chaudhary/.conda/envs/aiface/bin/python
JOB=${PBS_JOBID:?PBS GPU allocation required}
RECORD="$ROOT/allocation_${JOB}.json"
QSTAT="$ROOT/qstat_${JOB}.txt"
SESSION="$ROOT/profile_${JOB}"
/opt/pbs/bin/qstat -f "$JOB" > "$QSTAT"
if ! grep -q 'Resource_List.ngpus = 1' "$QSTAT"; then
  echo 'BLOCKED: PBS did not assign exactly one GPU' >&2
  exit 31
fi
if [[ -z "${CUDA_VISIBLE_DEVICES:-}" ]]; then
  echo 'BLOCKED: PBS supplied no CUDA_VISIBLE_DEVICES binding; do not guess a device index' >&2
  exit 32
fi
"$PY" -c 'import os,torch; assert torch.cuda.is_available() and torch.cuda.device_count()==1; print("CUDA_BINDING_PASS", os.environ["CUDA_VISIBLE_DEVICES"], torch.cuda.get_device_name(0))'
"$PY" - "$JOB" "$RECORD" "$QSTAT" <<'PY'
import json,os,sys
job,out,qstat=sys.argv[1:]
json.dump(dict(allocation_id=job,gpus=1,cuda_visible_devices=os.environ['CUDA_VISIBLE_DEVICES'],
    verified_by=os.environ.get('USER','cluster-operator'),evidence=qstat),open(out,'w'),indent=2)
PY
"$PY" "$SOURCE/CES_FL/proposals/ff2_expanded_baselines_20261104_r1/with_gpu_budget.py" \
  --ledger "$ROOT/../ff2_baseline_suite_s17_20261103T110324Z/additional72_gpu_hours.json" \
  --allocation "$RECORD" --session "ff2_expanded_profiles_${JOB}" --hours 4 \
  --out "$SESSION" -- \
  "$PY" "$ROOT/profile_all.py" "$SESSION"
