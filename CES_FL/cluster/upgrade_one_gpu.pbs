#!/usr/bin/env bash
# Operator submits explicitly after reviewing configuration and GPU allocation.
#PBS -N cesfl_upgrade
#PBS -q gpu
#PBS -l select=1:ncpus=8:ngpus=1:mem=48gb
#PBS -l walltime=12:00:00
#PBS -j oe
set -Eeuo pipefail
: "${CES_SOURCE_DIR:?Immutable detached source checkout required}"
: "${CES_TRAIN_CONFIG:?Reviewed relative config path required}"
: "${CES_OUTPUT_DIR:?New absolute output directory required}"
: "${CUDA_VISIBLE_DEVICES:?Operator must verify allocated physical device binding}"
CES_PY=${CES_PY:-/home/sachin.chaudhary/.conda/envs/aiface/bin/python}
CES_SMOKE_ONLY=${CES_SMOKE_ONLY:-1}
[[ "$CES_SMOKE_ONLY" = 0 || "$CES_SMOKE_ONLY" = 1 ]]
if git -C "$CES_SOURCE_DIR" symbolic-ref -q HEAD >/dev/null; then
  echo 'Use a detached immutable checkout.' >&2; exit 2
fi
[[ -z $(git -C "$CES_SOURCE_DIR" status --porcelain -- CES_FL) ]]
[[ "$CES_OUTPUT_DIR" = /* && ! -e "$CES_OUTPUT_DIR" ]]
[[ "$CES_OUTPUT_DIR/" != "$CES_SOURCE_DIR/"* ]]
cd "$CES_SOURCE_DIR"
git ls-files --error-unmatch "$CES_TRAIN_CONFIG" >/dev/null
"$CES_PY" -c 'import torch; assert torch.cuda.is_available(); assert torch.cuda.device_count()==1; print(torch.cuda.get_device_name(0))'
mkdir -p "$(dirname "$CES_OUTPUT_DIR")"
mkdir "$CES_OUTPUT_DIR"
export CES_SOURCE_DIR CES_OUTPUT_DIR CES_TRAIN_CONFIG CES_SMOKE_ONLY
"$CES_PY" - <<'PY'
import hashlib,json,os,subprocess
from pathlib import Path
source=Path(os.environ['CES_SOURCE_DIR']);out=Path(os.environ['CES_OUTPUT_DIR'])
paths=[source/'CES_FL/src/ces_fl_upgrade.py',source/'CES_FL/src/ces_fl_diagram_model_v021.py',source/os.environ['CES_TRAIN_CONFIG']]
record={'git_commit':subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),
 'sha256':{str(p.relative_to(source)):hashlib.sha256(p.read_bytes()).hexdigest() for p in paths},
 'pbs_jobid':os.environ.get('PBS_JOBID'),'cuda_visible_devices':os.environ['CUDA_VISIBLE_DEVICES'],
 'smoke_only':os.environ['CES_SMOKE_ONLY']=='1','note':'GPU visibility does not establish allocation ownership; operator verifies PBS binding.'}
(out/'launch.json').write_text(json.dumps(record,indent=2)+'\n')
PY
# pipefail prevents either failing preflight or failing smoke from starting training.
"$CES_PY" CES_FL/src/ces_fl_upgrade.py preflight --config "$CES_TRAIN_CONFIG" 2>&1 | tee "$CES_OUTPUT_DIR/preflight.log"
CES_UPGRADE_DEVICE=cuda "$CES_PY" -m unittest discover -s CES_FL/tests -p test_upgrade.py -v 2>&1 | tee "$CES_OUTPUT_DIR/smoke_cuda.log"
date -u '+%Y-%m-%dT%H:%M:%SZ CUDA software smoke passed' > "$CES_OUTPUT_DIR/CUDA_SMOKE_PASS"
if [[ "$CES_SMOKE_ONLY" = 1 ]]; then exit 0; fi
"$CES_PY" -u CES_FL/src/ces_fl_upgrade.py train-config --config "$CES_TRAIN_CONFIG" \
  --out "$CES_OUTPUT_DIR/training" --device cuda 2>&1 | tee "$CES_OUTPUT_DIR/training.log"
# Test evaluation is deliberately a separate frozen-protocol action.
