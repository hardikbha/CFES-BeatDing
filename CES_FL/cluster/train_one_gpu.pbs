#!/usr/bin/env bash
# Reviewed template only: this file is not submitted automatically.
#PBS -N cesfl_reviewed
#PBS -q gpu
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=04:00:00
#PBS -j oe

set -Eeuo pipefail
: "${CES_SOURCE_DIR:?Set the immutable detached Git worktree path}"
: "${CES_TRAIN_CONFIG:?Set the reviewed config path relative to that worktree}"
: "${CES_OUTPUT_DIR:?Set a new absolute output-package directory}"
: "${CUDA_VISIBLE_DEVICES:?Verify the job allocation and set its actual CUDA binding}"
CES_PY=${CES_PY:-/home/sachin.chaudhary/.conda/envs/aiface/bin/python}

if git -C "$CES_SOURCE_DIR" symbolic-ref -q HEAD >/dev/null; then
  echo 'Use a detached immutable worktree, not an actively edited branch.' >&2
  exit 2
fi
if [[ -n $(git -C "$CES_SOURCE_DIR" status --porcelain -- CES_FL) ]]; then
  echo 'The CES_FL source snapshot has uncommitted changes.' >&2
  exit 2
fi
[[ -f "$CES_SOURCE_DIR/$CES_TRAIN_CONFIG" ]]
[[ "$CES_OUTPUT_DIR" = /* ]]
[[ ! -e "$CES_OUTPUT_DIR" ]]
[[ "$CES_OUTPUT_DIR/" != "$CES_SOURCE_DIR/"* ]]

# Verify actual CUDA visibility before creating run outputs. This does not
# establish reservation ownership; the submitting operator must check PBS.
"$CES_PY" -c 'import torch; assert torch.cuda.is_available(); assert torch.cuda.device_count()==1; print(torch.cuda.get_device_name(0))'
mkdir -p "$(dirname "$CES_OUTPUT_DIR")"
mkdir "$CES_OUTPUT_DIR"
cp "$CES_SOURCE_DIR/$CES_TRAIN_CONFIG" "$CES_OUTPUT_DIR/config.json"
export CES_SOURCE_DIR CES_OUTPUT_DIR
"$CES_PY" - <<'PY'
import hashlib,json,os,subprocess
from pathlib import Path
source=Path(os.environ['CES_SOURCE_DIR']);out=Path(os.environ['CES_OUTPUT_DIR'])
code=source/'CES_FL/src/ces_fl_diagram_model_v021.py'
metadata={'git_commit':subprocess.check_output(['git','-C',str(source),'rev-parse','HEAD'],text=True).strip(),
          'source_sha256':hashlib.sha256(code.read_bytes()).hexdigest(),
          'config_sha256':hashlib.sha256((out/'config.json').read_bytes()).hexdigest(),
          'pbs_jobid':os.environ.get('PBS_JOBID'),'cuda_visible_devices':os.environ['CUDA_VISIBLE_DEVICES'],
          'declared_split_policy':'TRAIN updates; VAL selection/calibration; verify executable source',
          'note':'Actual training inputs/provenance must also be checked in training/provenance.json'}
(out/'launch_metadata.json').write_text(json.dumps(metadata,indent=2)+'\n')
PY
"$CES_PY" -u "$CES_SOURCE_DIR/CES_FL/src/ces_fl_diagram_model_v021.py" train-config \
  --config "$CES_OUTPUT_DIR/config.json" --out "$CES_OUTPUT_DIR/training" --device cuda
